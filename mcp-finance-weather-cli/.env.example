# ==========================================
# Configuración del Cliente (OpenAI)
# ==========================================
OPENAI_API_KEY=tu_api_key_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini
MCP_URL=http://127.0.0.1:8000

# ==========================================
# Configuración del Servidor MCP
# ==========================================

# --- ExchangeRate-API (Opcional pero recomendado) ---
# Si dejas la clave en blanco, el sistema usará el endpoint abierto por defecto.
# Para obtener tasas más actualizadas, regístrate en https://www.exchangerate-api.com/
API_KEY_EXCHANGE=tu_api_key_de_exchangerate_aqui

# Puedes sobrescribir las URLs base si la API cambia en el futuro
# BASE_URL_EXCHANGE_V6=https://v6.exchangerate-api.com/v6
# BASE_URL_EXCHANGE_OPEN=https://open.er-api.com/v6

# --- Open-Meteo (Totalmente gratuita, no requiere API key) ---
# BASE_URL_WEATHER=https://api.open-meteo.com/v1
# BASE_URL_GEOCODING=https://geocoding-api.open-meteo.com/v1/search

# --- Red ---
HTTP_TIMEOUT=10